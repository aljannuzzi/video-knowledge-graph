ENVIRONMENT=local
PORT=8080
# Auth bypass is allowed only for explicit local development.
LOCAL_AUTH_DISABLED=true
PUBLIC_ORIGIN=http://localhost:5173
COSMOS_ENDPOINT=https://<nosql-account>.documents.azure.com:443/
COSMOS_DATABASE=video-kg
COSMOS_SCENES_CONTAINER=scenes
COSMOS_CATALOG_CONTAINER=catalog
GREMLIN_ENDPOINT=wss://<graph-account>.gremlin.cosmos.azure.com:443/
GREMLIN_DATABASE=video-kg
GREMLIN_GRAPH=knowledge
# Obtain via Key Vault; never commit keys or a populated environment file.
GREMLIN_KEY=
AZURE_STORAGE_ACCOUNT=<storage-account>
AZURE_OPENAI_ENDPOINT=https://<openai-account>.openai.azure.com/
AZURE_OPENAI_VISION_DEPLOYMENT=scene-reasoning
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=scene-embedding
# In Azure this is a Key Vault-backed Container Apps secret.
APP_PASSWORD=
# Set AZURE_CLIENT_ID only for the user-assigned identity in Azure.
MAX_VIDEO_SECONDS=180
